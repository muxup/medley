import argparse
import difflib
import hashlib
import os
import re
import shlex
import subprocess
import sys
import tempfile
import textwrap
from collections.abc import Iterator
from pathlib import Path
from typing import NamedTuple

LINES_OF_CONTEXT = 3
# Match punctuation prefix, @agent, @agent! or @human, then any text after
# whitespace.
MARKER_LINE = re.compile(
    r"^(?P<prefix>\s*[^A-Za-z0-9\s]{2,}\s+)@(?P<tag>agent!?|human)(?P<text>\s.*)?$"
)
# The @agent part of MARKER_LINE, for rg to find candidate files.
RG_PATTERN = r"^\s*[^[:alnum:][:space:]]{2,}\s+@agent!?(?:\s|$)"


HEADER = """\
The user manually added these annotations for you, the agent, to react to.
They are either comment/explanation requests, which ask you to explain nearby
code or answer the user's question without editing files, or action requests,
which ask you to investigate and make the requested code change.
"""

CONVERSATION_HEADER = """\
The user is talking with you through @agent comments in their files. Each item
below is an @agent comment awaiting your reply, marked with > among nearby lines
and any earlier messages in its thread (your earlier replies appear as @human).
Line numbers refer to the files as they are now. The comments stay in the files
as a record of the conversation, so leave them in place. @agent! comments are
action requests asking you to change the code. Plain @agent comments ask only
for an answer.
"""

REPLY_FORMAT = """\
Reply to every item above, in the order listed, with a single command. Each
reply starts with a line of === and the item's id, shown in brackets after its
number, followed by the reply text on the next lines:
"""

REPLY_INSTRUCTIONS = """\
Keep the command and its file list as shown, and the quoted 'EOF' so the shell
leaves your text alone. If at-agent rejects the replies, nothing is written:
correct the ids and run the whole command again.

For action requests, make the code change with your normal tools before running
the command, and say briefly in that item's reply what you changed. If an edit
would put two different @agent threads on adjacent lines, separate them with a
blank line, as adjacent threads merge and their ids change. Each reply is
inserted into the file as a comment directly below its @agent comment. at-agent
adds the comment markers and the @human tag and wraps long lines, so write plain
text without them, with each paragraph or list item on a single line. Keep
replies short, as they will live in the code: a sentence or two is often enough,
and never more than three short paragraphs. Show any code by indenting it four
spaces rather than using ``` fences. at-agent --write-agent-reply reports
anything still pending, so once it says nothing is pending you are done: don't
re-read the files to check or run at-agent -c again."""


# A marker line and its continuation lines, lines[start:end], with the text of
# each.
class MarkerBlock(NamedTuple):
    start: int
    end: int
    prefix: str
    tag: str
    text: list[str]


# An @agent remark removed from a file, to be reported to the agent.
class RemovedRemark(NamedTuple):
    file: Path
    line: int
    kind: str
    text: list[str]
    context: list[str]


# An @agent remark, lines[start:end] of file, awaiting a @human reply, with
# the id and numbered context lines reported for it.
class PendingRemark(NamedTuple):
    file: Path
    start: int
    end: int
    prefix: str
    id: str
    context: list[str]


# Return the per-user state directory, creating it when needed.
def state_dir() -> Path:
    root = os.environ.get("XDG_STATE_HOME")
    directory = (
        Path(root) / "at-agent" if root else Path.home() / ".local/state/at-agent"
    )
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    return directory


# Read the editor-written queue of edited files, a "DIR_INODE NAME" line for
# each, returning the queued names keyed by directory inode. Unlike paths, these
# are the same inside and outside a sandbox, and unlike a file's inode, they
# survive a tool renaming a new file over it.
def read_edited_file_queue() -> dict[int, set[str]]:
    path = state_dir() / "edited_file_queue"
    try:
        lines = path.read_text().splitlines()
    except FileNotFoundError:
        print(f"warning: edited file queue not found: {path}", file=sys.stderr)
        return {}
    except (OSError, ValueError) as e:
        print(f"warning: could not read edited file queue {path}: {e}", file=sys.stderr)
        return {}
    queued: dict[int, set[str]] = {}
    for line in lines:
        dir_inode, _, name = line.partition(" ")
        if dir_inode.isdecimal() and name:
            queued.setdefault(int(dir_inode), set()).add(name)
        else:
            print(
                f"warning: ignoring malformed line in {path}: {line!r}", file=sys.stderr
            )
    return queued


# Return the paths of the queued files within the current directory tree.
def queued_paths(queued: dict[int, set[str]]) -> list[Path]:
    paths = []
    for directory, _, _ in Path.cwd().walk():
        try:
            dir_inode = directory.stat().st_ino
        except OSError:
            continue
        for name in queued.get(dir_inode, ()):
            path = directory / name
            if path.is_file() and not path.is_symlink():
                paths.append(path)
    return paths


# Find candidate files by scanning the current tree with ripgrep.
def rg_paths() -> list[Path]:
    try:
        result = subprocess.run(
            ["rg", "-l", RG_PATTERN, "."], text=True, capture_output=True
        )
    except OSError as e:
        print(f"warning: could not run rg: {e}", file=sys.stderr)
        return []
    if result.returncode == 1:
        return []
    if result.returncode:
        print(f"warning: rg failed: {result.stderr.strip()}", file=sys.stderr)
        return []
    return [Path(line) for line in result.stdout.splitlines()]


# Return continuation text when a following comment line shares the marker
# prefix. A line of just the prefix continues the block as a blank line.
def continuation(line: str, prefix: str) -> str | None:
    if line.rstrip() == prefix.rstrip():
        return ""
    if not line.startswith(prefix) or MARKER_LINE.match(line):
        return None
    return line[len(prefix) :]


# Yield each marker line and its continuation lines as a MarkerBlock.
def marker_blocks(lines: list[str]) -> Iterator[MarkerBlock]:
    i = 0
    while i < len(lines):
        marker = MARKER_LINE.match(lines[i])
        if not marker:
            i += 1
            continue
        start = i
        prefix, tag = marker["prefix"], marker["tag"]
        text = [(marker["text"] or "").strip()]
        i += 1
        while i < len(lines) and (cont := continuation(lines[i], prefix)) is not None:
            text.append(cont)
            i += 1
        yield MarkerBlock(start, i, prefix, tag, text)


# Whether the current directory is $HOME or one of its ancestors, so a tree
# scan would cover the whole home directory.
def scanning_home() -> bool:
    home = Path.home().resolve()
    cwd = Path.cwd().resolve()
    return cwd == home or cwd in home.parents


# Return candidate paths found by explicit args, rg, or the edited file queue.
def discover_paths(
    args: argparse.Namespace, parser: argparse.ArgumentParser
) -> list[Path]:
    mode = args.discover or ("args" if args.files else "queue")
    if mode == "args":
        if not args.files:
            parser.error("--discover=args requires file arguments")
        return [Path(p) for p in args.files]
    if args.files:
        parser.error(f"--discover={mode} does not accept file arguments")
    if mode == "rg" and scanning_home():
        parser.error("refusing to scan the home directory tree with rg")
    if mode == "queue" and scanning_home() and not (args.dry_run or args.chat):
        parser.error(
            "refusing to edit queued files under the home directory tree. Use --dry-run"
        )
    if mode == "rg":
        return rg_paths()
    if mode == "queue":
        return queued_paths(read_edited_file_queue())
    parser.error(f"unknown discovery mode: {mode}")


# Return the text of path, or None if it is unreadable or binary (heuristically,
# having a NUL byte near the start). Line endings are left untranslated, so CRLF
# lines keep their \r.
def read_text(path: Path) -> str | None:
    try:
        with path.open(encoding="utf-8", errors="surrogateescape", newline="") as f:
            text = f.read(8192)
            return None if "\0" in text else text + f.read()
    except OSError as e:
        print(f"warning: could not read {path}: {e}", file=sys.stderr)
        return None


# Write lines back to path, preserving undecodable bytes.
def write_lines(path: Path, lines: list[str]) -> None:
    path.write_text(
        "\n".join(lines), encoding="utf-8", errors="surrogateescape", newline=""
    )


# Remove @agent markers (and @human ones if strip is True), returning the
# removed remarks, and with strip a diff of the removed lines. Skip files we
# heuristically determine as being binary.
def process(
    path: Path, dry_run: bool, strip: bool
) -> tuple[list[RemovedRemark], list[str]]:
    file_text = read_text(path)
    if file_text is None:
        return [], []
    lines = file_text.split("\n")
    blocks = list(marker_blocks(lines))
    # Without --strip, skip a file holding a conversation, as removing only its
    # @agent remarks would leave the @human replies behind.
    if not strip and any(block.tag == "human" for block in blocks):
        print(
            f"warning: skipping {path}, which has @human replies: "
            "use at-agent -c to continue or --strip to end the conversation",
            file=sys.stderr,
        )
        return [], []

    clean_lines = []
    remarks = []
    pos = 0
    for start, end, _, tag, text in blocks:
        clean_lines += lines[pos:start]
        pos = end
        bang = tag == "agent!"
        ctx = lines[max(0, start - LINES_OF_CONTEXT) : start + 1 + LINES_OF_CONTEXT]
        if ctx and ctx[-1] == "" and file_text.endswith("\n"):
            ctx = ctx[:-1]
        remarks.append(
            RemovedRemark(
                file=path,
                # clean_lines contains every retained line before this marker,
                # so the next retained line is the same position the marker had
                # in the cleaned file. Context still comes from the original file.
                line=len(clean_lines) + 1,
                kind="action request" if bang else "comment/explanation request",
                text=[f"@{tag} {text[0] or '(no text)'}"] + text[1:],
                context=ctx,
            )
        )
    clean_lines += lines[pos:]

    if remarks and not dry_run:
        write_lines(path, clean_lines)
    if not strip:
        return remarks, []
    removed = difflib.unified_diff(
        lines, clean_lines, str(path), str(path), n=1, lineterm=""
    )
    return remarks, list(removed)


# Return the @agent remarks in paths that aren't directly followed by a @human
# reply, each with an id hashed from its thread so far.
def pending_remarks(paths: list[Path]) -> list[PendingRemark]:
    pending = []
    for path in sorted(paths):
        # Show paths in the current tree relative to it, for readability.
        if path.is_relative_to(Path.cwd()):
            path = path.relative_to(Path.cwd())
        file_text = read_text(path)
        if file_text is None:
            continue
        lines = file_text.removesuffix("\n").split("\n")
        thread_end = thread_prefix = None
        for start, end, prefix, tag, _ in marker_blocks(lines):
            if start != thread_end or prefix != thread_prefix:
                thread_start = start
            thread_end, thread_prefix = end, prefix
            following = MARKER_LINE.match(lines[end]) if end < len(lines) else None
            replied = (
                following is not None
                and following["prefix"] == prefix
                and following["tag"] == "human"
            )
            if tag == "human" or replied:
                continue
            thread = "\n".join(lines[thread_start:end])
            digest = hashlib.sha256(thread.encode(errors="surrogateescape"))
            pending.append(
                PendingRemark(
                    file=path,
                    start=start,
                    end=end,
                    prefix=prefix,
                    id=digest.hexdigest()[:4],
                    context=thread_context(lines, thread_start, start, end),
                )
            )
    return pending


# Return numbered lines around a block and its earlier thread, marking the
# block's own lines with >.
def thread_context(
    lines: list[str], thread_start: int, start: int, end: int
) -> list[str]:
    first = max(0, thread_start - LINES_OF_CONTEXT)
    stop = min(len(lines), end + LINES_OF_CONTEXT)
    ctx = []
    for n in range(first, stop):
        mark = ">" if start <= n < end else " "
        ctx.append(f"   {mark} {n + 1:4} | {lines[n]}")
    return ctx


# Format a reply as @human comment lines, wrapping all but blank or code lines.
def format_reply(text: str, prefix: str) -> list[str]:
    out = []
    for line in ("@human " + text.strip("\n")).split("\n"):
        if not line.strip() or line.startswith(("    ", "\t")):
            out.append(line.rstrip())
        else:
            out += textwrap.wrap(
                line, 100 - len(prefix), break_long_words=False, break_on_hyphens=False
            )
    return [prefix + line if line else prefix.rstrip() for line in out]


# Produce agent-facing report of pending remarks, with reply instructions.
def build_conversation_report(pending: list[PendingRemark]) -> str:
    lines = [CONVERSATION_HEADER]
    for i, remark in enumerate(pending, 1):
        lines += [f"{i}. [{remark.id}] {remark.file}:{remark.start + 1}"]
        lines += remark.context + [""]
    # List the files in the order --write-agent-reply will process them.
    files = sorted({remark.file for remark in pending})
    quoted = " ".join(shlex.quote(str(path)) for path in files)
    lines += [REPLY_FORMAT, f"at-agent --write-agent-reply {quoted} <<'EOF'"]
    for i, remark in enumerate(pending, 1):
        lines += [f"=== {remark.id}", f"Your reply to item {i}."]
    lines += ["EOF", "", REPLY_INSTRUCTIONS]
    return "\n".join(lines)


# Insert the replies read from stdin below the pending remarks they name, in
# order, working bottom-up so that line indices stay valid.
def reply(paths: list[Path], dry_run: bool) -> None:
    # Split stdin into ids, each followed by the text of its reply.
    parts = re.split(r"^=== *(\S+) *$", sys.stdin.read(), flags=re.MULTILINE)
    replies = list(zip(parts[1::2], parts[2::2]))
    pending = pending_remarks(paths)

    # Match each reply to the next pending remark with its id, so remarks the
    # agent hasn't seen are skipped and duplicate ids resolve in order.
    matched = []
    k = 0
    for rid, text in replies:
        while k < len(pending) and pending[k].id != rid:
            k += 1
        if k == len(pending):
            print(build_conversation_report(pending))
            sys.exit(
                f"error: reply '{rid}' doesn't match a pending item, or is out of "
                "order; no replies were inserted. The pending items are listed above."
            )
        matched.append((pending[k], text))
        k += 1

    files = {}
    for remark, text in reversed(matched):
        path, end = remark.file, remark.end
        if path not in files:
            file_text = read_text(path)
            if file_text is None:
                sys.exit(f"error: could not read {path}; no replies were inserted.")
            files[path] = file_text.split("\n")
        files[path][end:end] = format_reply(text, remark.prefix)
    if dry_run:
        print(f"{len(matched)} replies would be inserted across {len(files)} files.")
        return
    for path, lines in files.items():
        write_lines(path, lines)
    print(f"Inserted {len(matched)} replies.")


# Produce agent-facing report in standard format.
def build_report(remarks: list[RemovedRemark], dry_run: bool) -> str:
    lines = [HEADER]
    if dry_run:
        lines.append(
            "Dry run: @agent remark lines were not removed from the working tree."
        )
    else:
        lines.append(
            "The @agent remark lines have already been removed from the working tree."
        )
    lines += ["Relevant line numbers refer to the files after remark removal.", ""]

    for i, remark in enumerate(remarks, 1):
        lines += [
            f"{i}. {remark.file}",
            f"   kind: {remark.kind}",
            f"   relevant line number: {remark.line}",
            "   text:",
        ]
        lines += [f"     {line}" for line in remark.text]
        lines += ["   nearby context before removal:"]
        lines += [f"     {line}" for line in remark.context]
        lines += [""]
    return "\n".join(lines)


# Write text to a new temporary file, returning its path.
def write_temp_file(text: str, prefix: str) -> str:
    with tempfile.NamedTemporaryFile(
        "w",
        prefix=prefix,
        suffix=".txt",
        delete=False,
        encoding="utf-8",
        errors="surrogateescape",
    ) as f:
        f.write(text + "\n")
    return f.name


def main() -> None:
    parser = argparse.ArgumentParser(description="relay and remove @agent annotations")
    parser.add_argument(
        "--discover",
        choices=["queue", "args", "rg"],
        help="choose files from the edited file queue, arguments, or rg",
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="report remarks without editing files"
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "-c",
        "--chat",
        action="store_true",
        help="keep @agent remarks and report those awaiting a @human reply",
    )
    mode.add_argument(
        "--write-agent-reply",
        action="store_true",
        help="insert the agent's @human replies from stdin into the given files",
    )
    mode.add_argument(
        "--strip",
        action="store_true",
        help="remove all @agent and @human remarks, ending their conversations",
    )
    parser.add_argument("files", nargs="*")
    args = parser.parse_args()
    if args.write_agent_reply and not args.files:
        parser.error("--write-agent-reply requires file arguments")

    paths = discover_paths(args, parser)
    if args.write_agent_reply:
        reply(paths, args.dry_run)
        if args.dry_run:
            return
    if args.write_agent_reply or args.chat:
        pending = pending_remarks(paths)
        if not pending:
            print(
                "Nothing is pending. You are done: there is no need to re-read the "
                "files or run at-agent -c again."
            )
            return
        print(build_conversation_report(pending))
        return

    remarks = []
    removed = []
    for path in paths:
        path_remarks, path_removed = process(path, args.dry_run, args.strip)
        remarks.extend(path_remarks)
        removed.extend(path_removed)

    if not remarks:
        print("No @agent remarks found.")
        return
    if args.strip:
        action = "Would remove" if args.dry_run else "Removed"
        print(f"{action} {len(remarks)} @agent and @human remarks.")
        if not args.dry_run:
            backup = write_temp_file("\n".join(removed), "at-agent-strip-")
            print(f"Removed lines saved to: {backup}")
        return

    report = build_report(remarks, args.dry_run)
    print(report)
    print(f"Report also written to: {write_temp_file(report, 'at-agent-report-')}")


if __name__ == "__main__":
    main()
